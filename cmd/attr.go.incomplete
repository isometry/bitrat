package cmd

import (
	"fmt"
	"sync"

	"github.com/isometry/bitrat/hashattr"
	"github.com/isometry/bitrat/hasher"
	"github.com/isometry/bitrat/pathwalk"
	"github.com/spf13/cobra"
	"github.com/spf13/viper"
)

// attrCmd represents the attr command
var attrCmd = &cobra.Command{
	Use:   "attr",
	Short: "extended attribute management",
	Long:  ``,
	Run:   attrWalk,
}

func init() {
	attrCmd.PersistentFlags().String("attr-prefix", defaultAttrPrefix, "extended attribute prefix")
	viper.BindPFlag("attrPrefix", attrCmd.PersistentFlags().Lookup("attr-prefix"))

	rootCmd.AddCommand(attrCmd)
}

func attrWalk(cmd *cobra.Command, args []string) {
	var (
		fileWaitGroup   sync.WaitGroup
		attrWaitGroup   sync.WaitGroup
		sortWaitGroup   sync.WaitGroup
		outputWaitGroup sync.WaitGroup
	)

	fileChan := make(chan *pathwalk.File, viper.GetInt("readahead"))
	readAttrChan := make(chan *hasher.FileHash, defaultWriteahead)
	sortChan := make(chan *hasher.FileHash, 1024)

	h := hasher.New(viper.GetString("hash"), []byte(viper.GetString("hmac")))
	a := hashattr.New(fmt.Sprintf("%s.%s", viper.GetString("attrPrefix"), h.Type))

	outputWaitGroup.Go(hasher.OutputTextFile(sortChan))

	if viper.GetBool("sort") {
		sortWaitGroup.Go(hasher.SortByPath(readAttrChan, sortChan))
	} else {
		sortWaitGroup.Go(hasher.SortByFifo(readAttrChan, sortChan))
	}

	for range viper.GetInt("parallel") {
		attrWaitGroup.Go(a.Reader(fileChan, readAttrChan))
	}

	for _, path := range PathsToWalk(args) {
		var walker pathwalk.PathWalker
		if viper.GetBool("alt-walker") {
			walker = pathwalk.NewAltWalker(path, PathwalkOptions(), fileChan)
		} else {
			walker = pathwalk.NewWalker(path, PathwalkOptions(), fileChan)
		}
		fileWaitGroup.Go(walker.Walk)
	}

	fileWaitGroup.Wait()
	close(fileChan)
	attrWaitGroup.Wait()
	close(readAttrChan)
	sortWaitGroup.Wait()
	close(sortChan)
	outputWaitGroup.Wait()
}
